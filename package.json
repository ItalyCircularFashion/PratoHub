{
  "name": "pratohub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers playwright test",
    "db:generate": "prisma generate --schema database/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema database/schema.prisma",
    "db:seed": "node database/seeds/seed.js"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "typescript-eslint": "^8.31.0",
    "eslint": "^9.25.0",
    "typescript": "~5.8.3",
    "prisma": "6.19.0",
    "@prisma/client": "6.19.0"
  }
}
