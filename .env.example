POSTGRES_USER=pratohub
POSTGRES_DB=pratohub
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
DATABASE_URL=postgresql://pratohub:REPLACE_WITH_RANDOM_LOCAL_PASSWORD@127.0.0.1:55432/pratohub?schema=public
PORT=3000
# Generare 32 byte casuali in esadecimale; non usare questo segnaposto.
PRATOHUB_ADMIN_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
# Identità reale dell’operatore locale, non un nome fittizio.
PRATOHUB_ADMIN_ACTOR=REPLACE_WITH_REAL_OPERATOR_ID
